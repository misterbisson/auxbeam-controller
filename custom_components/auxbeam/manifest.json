{
  "domain": "auxbeam",
  "name": "Auxbeam / Qunchen Switch Panel",
  "version": "0.0.1",
  "config_flow": true,
  "documentation": "https://github.com/misterbisson/auxbeam-controller",
  "issue_tracker": "https://github.com/misterbisson/auxbeam-controller/issues",
  "codeowners": ["@misterbisson"],
  "iot_class": "local_push",
  "integration_type": "device",
  "dependencies": ["bluetooth_adapters"],
  "requirements": ["bleak-retry-connector>=3.5.0"],
  "bluetooth": [
    { "local_name": "Controller1*" },
    { "local_name": "Controller[4-9]*" }
  ]
}
